# Doxyfile minimal configuration for EvilAudio

PROJECT_NAME            = @EVIL_PROJECT_NAME@
PROJECT_BRIEF           = @EVIL_PROJECT_BRIEF@
OUTPUT_DIRECTORY        = @EVIL_OUTPUT_DIRECTORY@ 

EXCLUDE                 = @EVIL_EXCLUDE@
EXCLUDE_PATTERNS	    = @EVIL_EXCLUDE_PATTERNS@
INPUT                   = @EVIL_INPUT@

# Don't include std lib in diagrams
BUILTIN_STL_SUPPORT     = NO
EXCLUDE_SYMBOLS         = std std::* __gnu_cxx __gnu_cxx::*
HIDE_UNDOC_RELATIONS    = YES

INCLUDED_BY_GRAPH       = NO
GRAPHICAL_HIERARCHY     = YES
EXAMPLE_PATH            = @EVIL_EXAMPLE_PATH@

PLANTUML_JAR_PATH       = @EVIL_PLANTUML_JAR_PATH@
PLANTUML_CFG_FILE       = @EVIL_PLANTUML_CFG_FILE@
PLANTUML_INCLUDE_PATH   = @EVIL_PLANTUML_INCLUDE_PATH@
PLANTUMLFILE_DIRS       = @EVIL_PLANTUML_FILE_DIRS@

CPP_CLI_SUPPORT         = YES
HTML_FORMULA_FORMAT     = svg

HAVE_DOT                = YES
DOT_IMAGE_FORMAT        = svg
DOT_NUM_THREADS         = 4
DOT_UML_DETAILS         = NONE
MAX_DOT_GRAPH_DEPTH     = 12
UML_LOOK                = YES
INTERACTIVE_SVG         = YES

FULL_SIDEBAR            = NO
GENERATE_HTML           = YES
GENERATE_TREEVIEW       = YES
TEMPLATE_RELATIONS      = YES
LAYOUT_FILE             = @EVIL_HTML_LAYOUT_FILE@
HTML_EXTRA_STYLESHEET   = @EVIL_HTML_EXTRA_STYLESHEET@

GENERATE_XML            = YES
XML_NS_MEMB_FILE_SCOPE  = YES
XML_OUTPUT              = xml

FULL_PATH_NAMES         = NO
STRICT_PROTO_MATCHING   = YES
SORT_MEMBERS_CTORS_1ST  = YES
RECURSIVE               = YES
GENERATE_LATEX          = NO
QUIET                   = NO
WARNINGS                = YES
EXTRACT_ALL             = YES
